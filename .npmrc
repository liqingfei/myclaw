# Source installs require pinned pnpm; its settings are in pnpm-workspace.yaml.
# npm tooling needs npm 11.19+ for install/pack cooldowns and exclusions.
# Node 22's bundled npm 10 does not enforce these settings.
# npm expresses release age in days; pnpm uses minutes.
min-release-age=7
# Trusted Codex runtimes are outside the dependency cooldown.
min-release-age-exclude[]=@openai/codex
min-release-age-exclude[]=@openai/codex-*
# Route @openai scope through internal mirror to avoid timeout on large platform binaries.
@openai:registry=https://registry.anpm.alibaba-inc.com
